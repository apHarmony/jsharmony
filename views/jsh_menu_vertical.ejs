<a class="xmenuvertical_collapse" href="#">&nbsp;</a>
<div class="xmenuvertical">
  <%
var xmenu_headings = {};
var xmenu_icons = {'DASHBOARD' : 'dashboard', 'CUSTOMER' : 'people', 'REPORTS' : 'report', 'ADMIN' : 'settings', 'DEV' : 'code'};
if(locals.menudata && menudata.MainMenu){
  %><div class="xmenu"><%
    for(var i=0;i<menudata.MainMenu.length;i++){ var menuitem = menudata.MainMenu[i];
      xmenu_headings[menuitem.ID] = menuitem.Title;
      var hasSubmenu = menudata.SubMenus && menudata.SubMenus[menuitem.ID] && menudata.SubMenus[menuitem.ID].length;
      %><a href="<%-hasSubmenu?'#':menuitem.Link%>" onclick="<%-hasSubmenu?'':ejsext.escapeHTML(menuitem.OnClick?menuitem.OnClick+';return false;':'')%>" data-id="<%=menuitem.ID%>" class="xmenuitem xmenuitem_<%=ejsext.escapeCSSClass(menuitem.ID)%> <%-ejsext.iif(hasSubmenu,'has_submenu')%> <%-ejsext.iif(menuitem.Selected,'selected')%>"><span class="xmenuitem_icon material-icons"><%=xmenu_icons[menuitem.ID] || 'circle'%></span><span class="xmenuitem_label"><%=menuitem.Title%></span><div class="bottom"></div></a><%
  }
}
    %><a class="xmenu_more" href="#"><div class="xmenu_more_bg">Menu <img src="<%-req.jshsite.publicurl%>images/arrow_right_white.png" /><div class="bottom"></div></div></a><%
  %></div><%
  %><div class="xmenuside"></div><%
if(locals.menudata && menudata.SubMenus){
  for(var parentid in menudata.SubMenus){ var submenu = menudata.SubMenus[parentid];
    var parentname = '';
    if(parentid in xmenu_headings) parentname = xmenu_headings[parentid];
    %><div style="display:none;" class="xsubmenu xsubmenu_<%=ejsext.escapeCSSClass(parentid)%>" data-parent="<%=parentid%>"><div class="head"><%=parentname%>:</div><%
    for(var i=0;i<submenu.length;i++){ var menuitem = submenu[i];
      %><a href="<%-menuitem.Link%>" onclick="<%-ejsext.escapeHTML(menuitem.OnClick?menuitem.OnClick+';return false;':'')%>" data-id="<%=menuitem.ID%>" class="xsubmenuitem xsubmenuitem_<%=ejsext.escapeCSSClass(menuitem.ID)%> <%-ejsext.iif(menuitem.Selected,'selected')%>"><%=menuitem.Title%></a><%
    }
    %><a class="xsubmenu_more" href="#">Menu &nbsp;&#9656;</a><%
    %></div><%
    %><div class="xsubmenuside"></div><%
  }
}
%>
</div>