  XPage.Disable = function(ctrls,field,show_lookup) {
    if (ctrls && !_.isArrayLike(ctrls)) ctrls = [ctrls];
    _.forEach(ctrls, function(ctrl){
      XDom.class.remove(ctrl, 'editable');
      XDom.class.add(ctrl, 'uneditable');

      if (XDom.class.contains(ctrl, 'dropdown')) ctrl.disabled = true;
      else if (XDom.class.contains(ctrl, 'checkbox')) ctrl.disabled = true;
      else if (XDom.class.contains(ctrl, 'xform_ctrl_htmlarea')) ctrl.disabled = true;
      else if(XDom.class.contains(ctrl, 'xtagbox_base')){
        XDom.class.add(ctrl.previousElementSibling, 'uneditable');
        XDom(ctrl.previousElementSibling, 'input').element.disabled = true;
      }
      else ctrl.readOnly = true;
      if (!show_lookup && XDom.class.contains(ctrl.nextElementSibling, 'xlookup')) XDom.class.add(ctrl.nextElementSibling, 'uneditable');
      if(!field && (XDom.class.contains(ctrl, 'xform_ctrl') || XDom.class.contains(ctrl, 'xform_file_upload'))){
        field = XExt.getFieldFromObject(ctrl);
      }
      if(field && field.ondisabled) field.ondisabled(ctrl);
    });
  }

  XPage.Enable = function(ctrls,field) {
    if (ctrls && !_.isArrayLike(ctrls)) ctrls = [ctrls];
    _.forEach(ctrls, function(ctrl){
      XDom.class.remove(ctrl, 'uneditable');
      XDom.class.add(ctrl, 'editable');

      if (XDom.class.contains(ctrl, 'dropdown')) ctrl.disabled = false;
      else if (XDom.class.contains(ctrl, 'checkbox')) ctrl.disabled = false;
      else if (XDom.class.contains(ctrl, 'xform_ctrl_htmlarea')) ctrl.disabled = false;
      else if(XDom.class.contains(ctrl, 'xtagbox_base')){
        XDom.class.remove(ctrl.previousElementSibling, 'uneditable');
        XDom(ctrl.previousElementSibling, 'input').element.disabled = false;
      }
      else ctrl.readOnly = false;
      if (XDom.class.contains(ctrl.nextElementSibling, 'xlookup')) XDom.class.remove(ctrl.nextElementSibling, 'uneditable');
      if(!field && (XDom.class.contains(ctrl, 'xform_ctrl') || XDom.class.contains(ctrl, 'xform_file_upload'))){
        field = XExt.getFieldFromObject(ctrl);
      }
      if(field && field.onenabled) field.onenabled(ctrl);
    });
  }

